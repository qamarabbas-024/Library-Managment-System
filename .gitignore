# ===================================================
# Library Management System - C++ Project .gitignore
# ===================================================

# Compiled C++ binaries & object files
*.exe
*.o
*.obj
*.dll
*.so
*.dylib
*.a
*.lib

# Build output directories
build/
bin/
out/
dist/
target/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Runtime log files (generated at runtime, not source)
logs/

# Temporary/scratch files
scratch/
tmp/

# NOTE: data/*.csv files are the project's flat-file storage.
#       They are intentionally tracked in git as part of the project.
